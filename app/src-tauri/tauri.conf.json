{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Playalong",
  "version": "0.1.0",
  "identifier": "dev.playalong",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../ui" },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../ui" },
    "frontendDist": "../ui/build"
  },
  "app": {
    "windows": [
      {
        "title": "Playalong",
        "width": 1200,
        "height": 860,
        "minWidth": 760,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 20, "y": 26 }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "macOS": { "files": { "Resources/Assets.car": "icons/Assets.car" } },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
